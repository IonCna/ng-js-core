{
  "name": "ngjs-core",
  "version": "0.0.0",
  "module": "./dist/index.js",
  "dependencies": {
    "@types/angular-animate": "^1.5.14",
    "@uirouter/angularjs": "^1.1.2",
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-aria": "1.8.3",
    "angular-dynamic-locale": "^0.1.38",
    "angular-messages": "1.8.3",
    "angular-sanitize": "1.8.3",
    "angular-translate": "^2.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/angular": "^1.8.9",
    "@types/angular-mocks": "^1.7.4",
    "angular-mocks": "^1.8.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "tsc-alias": "^1.9.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js",
      "default": "./dist/common/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./runtime/core": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js",
      "default": "./dist/runtime/core/index.js"
    },
    "./runtime/common": {
      "types": "./dist/runtime/common/index.d.ts",
      "import": "./dist/runtime/common/index.js",
      "default": "./dist/runtime/common/index.js"
    },
    "./runtime/testing": {
      "types": "./dist/runtime/testing/index.d.ts",
      "import": "./dist/runtime/testing/index.js",
      "default": "./dist/runtime/testing/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js",
      "default": "./dist/compat/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js",
      "default": "./dist/router/index.js"
    },
    "./platform": {
      "types": "./dist/core/platform/index.d.ts",
      "import": "./dist/core/platform/index.js",
      "default": "./dist/core/platform/index.js"
    },
    "./rxjs-interop": {
      "types": "./dist/rxjs-interop/index.d.ts",
      "import": "./dist/rxjs-interop/index.js",
      "default": "./dist/rxjs-interop/index.js"
    },
    "./interop": {
      "types": "./dist/rxjs-interop/index.d.ts",
      "import": "./dist/rxjs-interop/index.js",
      "default": "./dist/rxjs-interop/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun esbuild.config.ts",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
