{
  "name": "ngjs-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun esbuild.config.ts",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "demo": "bun esbuild.demo.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/angular": "^1.8.9",
    "angular": "1.8.3",
    "esbuild": "^0.28.1",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.9.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "angular": "^1.8.3",
    "rxjs": "^7.8.2"
  }
}
